{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortTailwindcss": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".tanstack",
    ".opencode",
    "public",
    "bun.lock",
    "**/*.gen.*",
    "**/*.generated.*"
  ]
}
