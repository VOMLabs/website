# PostgreSQL connection string used by Drizzle ORM and the database client.
# Example: postgresql://user:password@host:5432/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/website-database"

# Base URL of the application used by Better Auth for redirects and cookies.
# Example: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Secret used to sign Better Auth sessions. Use a long random string.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-a-long-random-secret"
